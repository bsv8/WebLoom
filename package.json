{
  "name": "webloom",
  "version": "0.1.0",
  "description": "通用前端插件生命周期框架",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsv8/WebLoom.git"
  },
  "bugs": {
    "url": "https://github.com/bsv8/WebLoom/issues"
  },
  "homepage": "https://github.com/bsv8/WebLoom#readme",
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsup",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "prepack": "pnpm typecheck && pnpm test && pnpm build && pnpm lint:boundaries",
    "pack": "npm pack",
    "pack:consumer": "pnpm run prepack && node scripts/pack-consumer-smoke.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "jsdom": "25.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsup": "8.5.1",
    "typescript": "5.5.4",
    "vitest": "3.2.4"
  }
}
